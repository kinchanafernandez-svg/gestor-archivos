# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=distributed_system
DB_USER=postgres
DB_PASSWORD=postgres123

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Node Configuration
NODE_ENV=development
REPLICATION_FACTOR=3
HEARTBEAT_INTERVAL=5000

# Service Ports
USER_SERVICE_PORT=50051
FILE_SERVICE_PORT=50052
AUDITOR_SERVICE_PORT=50053
NODE_SERVICE_PORT=50054
SECURITY_SERVICE_PORT=50055
LOADBALANCER_SERVICE_PORT=50056

# TLS Configuration (optional)
USE_TLS=false
TLS_CERT_PATH=/certs/server.crt
TLS_KEY_PATH=/certs/server.key

# File Storage
FILE_STORAGE_PATH=/data/files
MAX_FILE_SIZE=104857600

# Leader Election
ELECTION_TIMEOUT=10000
LEADER_LEASE_DURATION=30000
