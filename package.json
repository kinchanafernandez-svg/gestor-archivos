{
  "name": "distributed-system-monorepo",
  "version": "1.0.0",
  "description": "Sistema distribuido con Node.js, TypeScript, gRPC y Docker",
  "private": true,
  "workspaces": [
    "services/*",
    "shared/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "docker-compose up --build",
    "start": "bash scripts/start-services.sh",
    "stop": "bash scripts/stop-services.sh",
    "logs": "bash scripts/view-logs.sh",
    "health": "bash scripts/health-check.sh",
    "test:client": "ts-node scripts/test-client.ts",
    "proto:generate": "npm run proto:generate --workspaces",
    "clean": "npm run clean --workspaces && docker-compose down -v"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tailwindcss": "^4.1.9",
    "postcss": "8.5.6"
  },
  "dependencies": {
    "jsonwebtoken": "9.0.2",
    "crypto": "1.0.1",
    "bcryptjs": "3.0.2",
    "@grpc/grpc-js": "1.14.0",
    "next": "15.5.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.546.0",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7",
    "@distributed/utils": "0.1.0",
    "@grpc/proto-loader": "0.8.0",
    "path": "0.12.7",
    "fs": "0.0.1-security"
  }
}
